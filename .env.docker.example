APP_NAME="De Viaje"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

# 127.0.0.1 para un proxy HTTPS en el servidor; 0.0.0.0 para acceso por IP.
APP_BIND=127.0.0.1
APP_PORT=8080
# Solo direcciones de proxies de confianza. Vacío si no hay proxy.
TRUSTED_PROXIES=

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=de_viaje
DB_USERNAME=agencia
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=log
MAIL_FROM_ADDRESS=agencia@example.com
MAIL_FROM_NAME="${APP_NAME}"
